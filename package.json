{
  "name": "proposal-module-server",
  "version": "1.6.3",
  "description": "Proposal Module Server",
  "main": "server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test:guards": "node __tests/run-guards.js",
    "test:mailer": "node --test mailer/tests/*.test.js",
    "test:helper": "node --test helper/__tests__/*.test.js",
    "test": "npm run test:guards && npm run test:mailer && npm run test:helper",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server.js",
    "backup": "node backup/backup.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "node scripts/tag-release.mjs",
    "changeset:snapshot": "changeset version --snapshot rc"
  },
  "keywords": [],
  "author": "Mad Orkestra & Adam Dean for Lerna Labs",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "^15.0.3",
    "@lerna-labs/ekklesia-helpers": "^2.0.1",
    "@meshsdk/core": "^1.9.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "googleapis": "^174.0.0",
    "handlebars": "^4.7.9",
    "intl-messageformat": "^11.2.13",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "nodemailer": "^10.0.2",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "overrides": {
    "undici": "^6.28.1",
    "ip-address": "^10.7.1",
    "nanoid": "^3.3.18",
    "brace-expansion": "^2.1.7",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
