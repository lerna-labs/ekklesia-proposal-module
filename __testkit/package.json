{
  "name": "__testkit",
  "version": "1.0.0",
  "description": "Tests for the Ekklesia Proposal Module API",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:full": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config jest.config.full.js",
    "test:login": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/login.test.js",
    "test:session:ratelimit": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/session-rate-limit.test.js --testTimeout=120000",
    "test:permissions": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/proposal-permissions.test.js --testTimeout=120000",
    "test:window:rules": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/window-rules.test.js --testTimeout=180000",
    "test:comment:ratelimit": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/comment-rate-limit.test.js --testTimeout=120000",
    "test:public:ratelimit": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/z-public-rate-limit.test.js --testTimeout=120000",
    "test:perf:smoke": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/performance/timing.test.js --testTimeout=120000",
    "test:perf": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/performance.test.js tests/performance/timing.test.js --testTimeout=300000",
    "test:ratelimit": "node --no-webstorage --experimental-vm-modules node_modules/jest/bin/jest.js tests/z-public-rate-limit.test.js --testTimeout=120000",
    "seed:perf": "node scripts/seed-perf.js",
    "seed:perf:teardown": "node scripts/seed-perf.js --teardown"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^16.4.5",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  }
}
