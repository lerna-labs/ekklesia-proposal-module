# Base URL of the Proposal Module API (no trailing slash).
# Default: http://localhost:3000/api/v0
# API_BASE_URL=http://localhost:3000/api/v0

# Required for expired-token tests (GET/DELETE /session with expired JWT). Must match backend JWT_SECRET.
# If unset, those tests are skipped.
# JWT_SECRET=your-backend-jwt-secret

# Prerequisites for session tests:
# - Backend must be running at API_BASE_URL
# - cardano-signer CLI on PATH (see docs/cardano-signer.md)
# - DRep keys in keys/drep01_jag and keys/drep02_w9c (drep.skey, drep_id.txt); drep01 (and drep02 if used for login) must be registered (Koios)

# Performance test (tests/performance.test.js): MongoDB for seeding vote + 20k proposals.
# Use MONGO_URI or MONGODB_HOST + MONGODB_PORT + MONGODB_DATABASE (and optionally MONGODB_USERNAME, MONGODB_PASSWORD, MONGODB_AUTH_SOURCE).
# MONGO_URI=mongodb://localhost:27017/your_database
# Performance test (remote): optional. If set, test uses these instead of discovering from API.
# Get values by running: npm run seed:perf (from __testkit; needs MongoDB).
# PERF_VOTE_ID=
# PERF_PROPOSAL_ID=
# PERF_VOTE_SLUG=perf-test-20k
