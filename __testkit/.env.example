# Base URL of the Proposal Module API (no trailing slash).
# Default: http://localhost:3000/api/v0
# API_BASE_URL=http://localhost:3000/api/v0

# Prerequisites for login tests:
# - Backend at API_BASE_URL
# - cardano-signer on PATH (see docs/cardano-signer.md)
# - DRep keys in keys/drep01_jag and keys/drep02_w9c; signers must be registered (backend validates via Koios)

# Performance / discovery (tests/performance.test.js): optional. If unset, test discovers vote by slug.
# PERF_VOTE_ID=
# PERF_PROPOSAL_ID=
# PERF_VOTE_SLUG=ekklesia-testkit

# Optional: duplicate-treasury-hash + window-rules live transitions.
# Must be a real mainnet tx hash where the proposer stake (keys/drep01_jag) is in the tx inputs (verified via Koios).
# TESTKIT_TREASURY_HASH=
# Backward-compatible alias also supported:
# TESTKIT_TREASURY_DONATION_TX_HASH=

# MongoDB — only for npm run seed:perf / seed:perf:teardown (same DB as the API process).
# MONGO_URI=mongodb://localhost:27017/your_database
# Or: MONGODB_HOST, MONGODB_PORT, MONGODB_DATABASE, and if needed MONGODB_USERNAME, MONGODB_PASSWORD, MONGODB_AUTH_SOURCE
