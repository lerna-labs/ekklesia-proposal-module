VITE_API_URL=/api/v0 # api base url
VITE_SERVER_STATUS=/health # health endpoint 
VITE_MAINTENANCE_MODE=false # true or false to show maintenance banner
VITE_WALLETSIGNER_USER_TYPES=stake,drep # stake, drep, pool, addr
VITE_WALLETSIGNER_USER_DEFAULT=stake # default user type to select
VITE_WALLETSIGNER_MULTISIG=false # true or false to enable/disable multisig options