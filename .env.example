# Express configuration
SERVER_PORT=3001

# Network config
NETWORK_ID=0
NETWORK_NAME=preprod

# MongoDB configuration
MONGODB_HOST=
MONGODB_PORT=27017
MONGODB_DATABASE=bugdet-module
MONGODB_USERNAME=admin
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# JWT configuration
JWT_SECRET=
JWT_MAX_AGE=1d # takes seconds, hours or days as suffix

# API configuration for external services
API_URL=https://preprod.koios.rest/api/v1
API_TOKEN=

# API Configuration for Blockfrost fallback
BLOCKFROST_URL=
BLOCKFROST_PROJECT_ID=

PRIMARY_PROVIDER=koios

# GitHub token for installing @lerna-labs/ekklesia-helpers from GitHub Packages
# Requires a PAT with read:packages scope
GITHUB_TOKEN=