# Express configuration
SERVER_PORT=3001

# Network config
NETWORK_ID=0
NETWORK_NAME=preprod

# MongoDB configuration
MONGODB_HOST=
MONGODB_PORT=27017
MONGODB_DATABASE=budget-module
MONGODB_USERNAME=admin
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# JWT configuration
JWT_SECRET=
JWT_MAX_AGE=1d # takes seconds, hours or days as suffix

# API configuration for external services
API_URL=https://preprod.koios.rest/api/v1
API_TOKEN=

# Frontend URL (used for magic-link verification links)
FRONTEND_URL=http://localhost:5173

# Email transport configuration
# mailtrap = Mailtrap sandbox API | google = Gmail API (Workspace; requires google_keys.json + delegation)
EMAIL_PROVIDER=mailtrap
MAILTRAP_INBOX_ID=
MAILTRAP_TOKEN=
MAIL_FROM_EMAIL=notifications@ekklesia.example
MAIL_FROM_NAME=Ekklesia
EMAIL_BRAND=default

# Google Workspace (when EMAIL_PROVIDER=google):
# Path to service account JSON (defaults to ./google_keys.json at repo root if unset)
# GOOGLE_APPLICATION_CREDENTIALS=
# GMAIL_SERVICE_ACCOUNT_KEY_PATH=
# Workspace user to impersonate (domain-wide delegation; Gmail send scope)
# GMAIL_IMPERSONATE_USER=
# IMPERSONATE_USER=   # alias for GMAIL_IMPERSONATE_USER (matches common scripts)
# Recipient for mailer/dev-tests sample sends when EMAIL_PROVIDER=google (required; delivers real mail)
# MAILTEST_TO_EMAIL=
# GOOGLE_DEV_TEST_EMAIL=   # alias for MAILTEST_TO_EMAIL in dev tests only

# Bulk cron fan-out: delay in ms after each successful/failed send to the next recipient (default 300; 0 = off)
EMAIL_FANOUT_DELAY_MS=300

# Transport retries on 429 / transient errors (Mailtrap + Google)
EMAIL_SEND_MAX_ATTEMPTS=5
EMAIL_SEND_RETRY_BASE_MS=800

# mailer/dev-tests/email-events.test.js: same as MAILTRAP_SEND=1 (fail if sample send errors); works for any EMAIL_PROVIDER
# EMAIL_SEND_FAIL_HARD=1

# Notification verification abuse controls
NOTIFICATION_VERIFY_RECIPIENT_COOLDOWN_MS=86400000
NOTIFICATION_VERIFY_LEDGER_TTL_SECONDS=604800
NOTIFICATION_VERIFY_DISPATCH_MAX_PER_HOUR=5

# Set to 1, true, or yes to disable all express rate limiters (local dev / tests only; do not use in production).
# DISABLE_RATE_LIMIT=