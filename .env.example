# Express configuration
SERVER_PORT=3001

# Network config
NETWORK_ID=0
NETWORK_NAME=preprod

# MongoDB configuration
MONGODB_HOST=
MONGODB_PORT=27017
MONGODB_DATABASE=bugdet-module
