# Test-harness overrides for __emails/test.js. Copy to __emails/.env and fill in.
# Loaded AFTER the project's .env / .env.${NODE_ENV}, with override=true, so any
# values here win. Git-ignored.

MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_TO=inbox@ekklesia.test
MAILTRAP_FROM=no-reply@ekklesia.test
MAILTRAP_FROM_NAME=Ekklesia (sandbox)

# Brand config applied to every render. Bare name (resolves against
# __emails/branding/<name>.json) or an absolute/relative path to a JSON file.
# Overridden by --brand=... on the CLI. Leave unset for branding/default.json.
EMAIL_BRAND=

# BCP 47 locale tag used to resolve __emails/i18n/<tag>.json. Falls back
# requested → base language → en (per TRD §4.6 SL-051). Overridden by
# --locale=... on the CLI. Leave unset for en.
EMAIL_LOCALE=
